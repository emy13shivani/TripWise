                rating: "4.8",
                image: "https://images.unsplash.com/photo-1515488042361-ee00e0ddd4e4?auto=format&fit=crop&w=600&q=80",
                description: "Historic Saxon trade fair cities, Bach music heritage, and canal-lined art districts.",
                hostels: ["Hostel preussen", "Central Globetrotter Leipzig", "Halle Backpackers Hostel"],
                transportInfo: {
                    mode: "Deutsche Bahn ICE High-Speed Train",
                    details: "Direct ICE fast train from Berlin Hauptbahnhof to Leipzig / Halle Central Station.",
                    mapQuery: "Leipzig+Germany"
                }
            }
        ];

        let journalEntries = JSON.parse(localStorage.getItem('cartographer_journal')) || [];
        let currentModalItem = null;

        window.addEventListener('DOMContentLoaded', () => {
            renderExpeditions(globalExpeditions);
            updateJournalCount();
            startPocketWatch();
        });

        // Interactive Pocketwatch Clock
        function startPocketWatch() {
            setInterval(() => {
                const now = new Date();
                document.getElementById('pocketWatchDisplay').textContent = now.toLocaleTimeString();
            }, 1000);
        }

        function togglePocketWatch() {
            const icon = document.getElementById('watchIcon');
            icon.classList.toggle('fa-spin');
        }

        // API Modal Actions
        function openApiModal() { document.getElementById('apiModal').classList.remove('hidden'); }
        function closeApiModal() {
            document.getElementById('apiModal').classList.add('hidden');
            document.getElementById('apiStatusText').textContent = "Key Linked Active";
        }

        // Filtering Logic
        function filterExpeditions() {
            const scope = document.getElementById('filterScope').value;
            const transport = document.getElementById('filterTransport').value;
            const search = document.getElementById('searchInput').value.toLowerCase();

            const filtered = globalExpeditions.filter(item => {
                const matchScope = scope === 'all' || item.type === scope;
                const matchTransport = transport === 'all' || item.transport === transport;
                const matchSearch = item.name.toLowerCase().includes(search) || item.category.toLowerCase().includes(search);
                return matchScope && matchTransport && matchSearch;
            });

            renderExpeditions(filtered);
        }

        function renderExpeditions(items) {
            const grid = document.getElementById('destinationsGrid');
            grid.innerHTML = '';

            if (items.length === 0) {
                grid.innerHTML = `<div class="col-span-3 text-center py-12 text-[#5c4331] italic">No cartographic expeditions found matching your criteria.</div>`;
                return;
            }

            items.forEach(item => {
                const isSaved = journalEntries.some(e => e.id === item.id);
                const card = document.createElement('div');
                card.className = "polaroid cursor-pointer flex flex-col justify-between";
                card.innerHTML = `
                    <div onclick="openModal(${item.id})" class="overflow-hidden h-52 relative border border-[#2c221e]/20">
                        <img src="${item.image}" class="w-full h-full object-cover grayscale contrast-125 sepia hover:scale-105 transition duration-500">
                        <span class="absolute top-2 right-2 bg-[#2c221e] text-[#f4ecd8] text-[10px] font-bold px-2 py-0.5 rounded">★ ${item.rating}</span>
                    </div>
                    <div class="pt-4 space-y-2" onclick="openModal(${item.id})">
                        <span class="text-[10px] uppercase font-bold text-[#7c6351]">${item.category}</span>
                        <h3 class="heading-font text-lg text-[#2c221e]">${item.name}</h3>
                        <p class="text-xs text-[#5c4331] line-clamp-2">${item.description}</p>
                    </div>
                    <div class="pt-3 mt-3 border-t border-dashed border-[#d3c2a5] flex justify-between items-center">
                        <span class="text-[11px] font-bold text-[#4a3525] underline" onclick="openModal(${item.id})">Inspect Ledger</span>
                        <button onclick="event.stopPropagation(); toggleJournal(${item.id})" class="px-3 py-1 bg-[#2c221e] text-[#f4ecd8] text-[11px] rounded font-bold">
                            ${isSaved ? 'In Checklist ✓' : '+ Add'}
                        </button>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        // Modal Handling
        function openModal(id) {
            const item = globalExpeditions.find(e => e.id === id);
            if (!item) return;
            currentModalItem = item;

            document.getElementById('modalImg').src = item.image;
            document.getElementById('modalPolaroidCaption').textContent = item.name;
            document.getElementById('modalTitle').textContent = item.name;
            document.getElementById('modalCategory').textContent = item.category;
            document.getElementById('modalLocation').innerHTML = `<i class="fa-solid fa-compass mr-1"></i> ${item.type.toUpperCase()} EXPEDITION`;
            document.getElementById('modalDescription').textContent = item.description;

            // Hostels list
            document.getElementById('modalHostels').innerHTML = item.hostels.map(h => `<li class="notebook-line"><i class="fa-solid fa-bed text-amber-800 mr-2"></i> ${h}</li>`).join('');

            // Transport info
            document.getElementById('modalTransportBox').innerHTML = `
                <p class="font-bold text-[#2c221e]"><i class="fa-solid fa-ticket mr-1"></i> ${item.transportInfo.mode}</p>
                <p class="text-[#5c4331]">${item.transportInfo.details}</p>
            `;

            // Embedded Google Maps iframe simulation
            document.getElementById('mapFrame').src = `https://maps.google.com/maps?q=${item.transportInfo.mapQuery}&t=&z=13&ie=UTF8&iwloc=&output=embed`;

            updateModalButtonState();
            document.getElementById('detailModal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('detailModal').classList.add('hidden');
            currentModalItem = null;
        }

        function updateModalButtonState() {
            if (!currentModalItem) return;
            const btn = document.getElementById('modalAddBtn');
            const isSaved = journalEntries.some(e => e.id === currentModalItem.id);
            btn.textContent = isSaved ? 'Remove from Notebook Checklist' : 'Add to Notebook Checklist';
        }

        // Journal / Itinerary management
        function toggleJournal(id) {
            const item = globalExpeditions.find(e => e.id === id);
            if (!item) return;

            const index = journalEntries.findIndex(e => e.id === id);
            if (index > -1) {
                journalEntries.splice(index, 1);
            } else {
                journalEntries.push(item);
            }

            localStorage.setItem('cartographer_journal', JSON.stringify(journalEntries));
            updateJournalCount();
            renderExpeditions(globalExpeditions);
            if (currentModalItem && currentModalItem.id === id) {
                updateModalButtonState();
            }
        }

        function toggleJournalFromModal() {
            if (currentModalItem) toggleJournal(currentModalItem.id);
        }

        function clearJournal() {
            journalEntries = [];
            localStorage.setItem('cartographer_journal', JSON.stringify(journalEntries));
            updateJournalCount();
            renderExpeditions(globalExpeditions);
            renderNotebookItinerary();
        }

        function updateJournalCount() {
            document.getElementById('itineraryCount').textContent = journalEntries.length;
        }

        function switchTab(tab) {
            const explore = document.getElementById('viewExplore');
            const itinerary = document.getElementById('viewItinerary');
            const btnExp = document.getElementById('btnExplore');
            const btnIti = document.getElementById('btnItinerary');

            if (tab === 'explore') {
                explore.classList.remove('hidden');
                itinerary.classList.add('hidden');
                btnExp.className = "flex-1 bg-[#2c221e] text-[#f4ecd8] py-2.5 px-4 rounded text-xs font-bold uppercase tracking-wider mr-2";
                btnIti.className = "flex-1 bg-[#d3c2a5] text-[#2c221e] py-2.5 px-4 rounded text-xs font-bold uppercase tracking-wider border border-[#4a3525]";
            } else {
                explore.classList.add('hidden');
                itinerary.classList.remove('hidden');
                btnIti.className = "flex-1 bg-[#2c221e] text-[#f4ecd8] py-2.5 px-4 rounded text-xs font-bold uppercase tracking-wider border border-[#4a3525]";
                btnExp.className = "flex-1 bg-[#d3c2a5] text-[#2c221e] py-2.5 px-4 rounded text-xs font-bold uppercase tracking-wider mr-2";
                renderNotebookItinerary();
            }
        }

        function renderNotebookItinerary() {
            const list = document.getElementById('itineraryNotebookList');
            list.innerHTML = '';

            if (journalEntries.length === 0) {
                list.innerHTML = `<p class="text-xs text-[#5c4331] italic text-center py-8">Your notebook checklist is currently empty. Add waypoints from the Atlas.</p>`;
                return;
            }

            journalEntries.forEach((entry, idx) => {
                const row = document.createElement('div');
                row.className = "notebook-line flex items-center justify-between text-xs py-2 px-3 bg-[#f9f5eb] rounded border border-[#d3c2a5]";
                row.innerHTML = `
                    <div class="flex items-center gap-3">
                        <span class="font-bold text-[#4a3525]">${idx + 1}.</span>
                        <div>
                            <strong class="heading-font text-[#2c221e] text-sm">${entry.name}</strong>
                            <span class="text-[#7c6351] block text-[11px]">${entry.transportInfo.mode}</span>
                        </div>
                    </div>
                    <button onclick="toggleJournal(${entry.id})" class="text-red-800 font-bold hover:underline">Remove</button>
                `;
                list.appendChild(row);
            });
        }
    </script>
</body>
</html>
