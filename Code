        }
        .heading-font { font-family: 'Special Elite', cursive; }
        
        .polaroid {
            background: #fffdf9;
            padding: 12px 12px 35px 12px;
            box-shadow: 3px 4px 12px rgba(44, 34, 30, 0.15);
            transition: transform 0.3s ease;
        }
        .polaroid:hover {
            transform: scale(1.02) rotate(1deg);
            z-index: 10;
        }

        .notebook-line {
            border-bottom: 1px dashed #d3c2a5;
            line-height: 2rem;
        }
