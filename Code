            <div class="flex justify-end gap-2 pt-2">
                <button onclick="closeApiModal()" class="px-4 py-2 bg-[#2c221e] text-[#f4ecd8] text-xs rounded font-bold">Save & Close</button>
            </div>
        </div>
    </div>

    <header class="border-b-2 border-[#2c221e] py-6 px-8 max-w-7xl mx-auto w-full flex flex-col md:flex-row items-center justify-between gap-4">
        <div>
            <h1 class="heading-font text-3xl md:text-4xl text-[#2c221e] tracking-wider">TripWise</h1>
            <p class="text-xs text-[#5c4331] italic mt-1">Railway schedules,Cruise routes & Global waypoints.</p>
        </div>

        <div onclick="togglePocketWatch()" class="bg-[#fffdf9] border-2 border-[#4a3525] px-5 py-3 rounded-2xl shadow-md flex items-center gap-4 cursor-pointer hover:bg-[#f9f5eb] transition">
            <div class="w-10 h-10 rounded-full bg-[#2c221e] text-[#f4ecd8] flex items-center justify-center text-lg shadow-inner">
                <i class="fa-solid fa-clock-rotate-left" id="watchIcon"></i>
            </div>
            <div>
                <span class="text-[10px] uppercase font-bold tracking-widest text-[#7c6351]">Time</span>
                <div id="pocketWatchDisplay" class="heading-font text-lg text-[#2c221e]">12:00:00 AM</div>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-6 py-8 flex-grow w-full space-y-10">

        <div class="bg-[#fffdf9] border-2 border-[#2c221e] p-6 rounded-2xl shadow-md grid grid-cols-1 md:grid-cols-4 gap-4 items-center">
            <div>
                <label class="block text-[11px] uppercase font-bold text-[#4a3525] mb-1">Journey Territory</label>
                <select id="filterScope" onchange="filterExpeditions()" class="w-full p-2.5 bg-[#f4ecd8] border border-[#4a3525] rounded text-xs font-bold">
                    <option value="all">All Global Expeditions</option>
                    <option value="domestic">Domestic Expeditions (India)</option>
                    <option value="international">International Voyages</option>
                </select>
            </div>
            <div>
                <label class="block text-[11px] uppercase font-bold text-[#4a3525] mb-1">Transport Vessel</label>
                <select id="filterTransport" onchange="filterExpeditions()" class="w-full p-2.5 bg-[#f4ecd8] border border-[#4a3525] rounded text-xs font-bold">
                    <option value="all">All Transports (Train, Ship, Flight, Road)</option>
                    <option value="train">Railway</option>
                    <option value="ship">Cruise</option>
                    <option value="flight">Aviation</option>
                    <option value="road">Road Trip</option>
                </select>
            </div>
            <div>
                <label class="block text-[11px] uppercase font-bold text-[#4a3525] mb-1">Search Waypoint</label>
                <input type="text" id="searchInput" placeholder="Search cities, ports..." oninput="filterExpeditions()" class="w-full p-2.5 bg-[#f4ecd8] border border-[#4a3525] rounded text-xs">
            </div>
            <div class="flex items-end h-full pt-5 md:pt-0">
                <button onclick="switchTab('explore')" id="btnExplore" class="flex-1 bg-[#2c221e] text-[#f4ecd8] py-2.5 px-4 rounded text-xs font-bold uppercase tracking-wider mr-2">Atlas</button>
                <button onclick="switchTab('itinerary')" id="btnItinerary" class="flex-1 bg-[#d3c2a5] text-[#2c221e] py-2.5 px-4 rounded text-xs font-bold uppercase tracking-wider border border-[#4a3525]">Journal (<span id="itineraryCount">0</span>)</button>
            </div>
        </div>

        <div id="viewExplore" class="space-y-8">
